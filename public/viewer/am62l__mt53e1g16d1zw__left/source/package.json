{
  "name": "quick-configure",
  "version": "0.1.0",
  "private": true,
  "description": "Selectable tscircuit board family for optical, environmental, motion, thermal, and display designs",
  "scripts": {
    "build": "npm run build:circuits && npm run build:ddr && npm run assemble-site",
    "build:circuits": "npm run check:schematic-placement && npm run models && bun run scripts/build-circuit-artifacts.ts && bun run resources",
    "build:circuits:plan": "bun run scripts/build-circuit-artifacts.ts --plan",
    "assemble-site": "bun run scripts/assemble-site.ts",
    "models": "bun run scripts/generate-screen-models.ts && bun run scripts/generate-mspm0-model.ts",
    "resources": "bun run scripts/generate-resources.ts",
    "check:schematic-placement": "bun run scripts/check-schematic-placement.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:ddr": "bun run scripts/build-ddr-artifacts.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "devDependencies": {
    "@jscad/modeling": "2.13.0",
    "@tscircuit/capacity-autorouter": "0.0.866",
    "@tscircuit/core": "0.0.1830",
    "@tscircuit/fanout-solver": "0.0.54",
    "@tscircuit/props": "0.0.646",
    "@tscircuit/winding-breakout-point-solver": "https://github.com/tscircuit/winding-breakout-point-solver/archive/202dbe9eb0088633b6fa094120dba6f2f41f8803.tar.gz",
    "@types/react": "^19.2.18",
    "altiumts": "^0.0.23",
    "bun-types": "1.3.14",
    "circuit-json": "0.0.480",
    "circuit-json-to-altium": "https://github.com/tscircuit/circuit-json-to-altium/archive/9156ef818d558278eacb37a9d96a326163aece75.tar.gz",
    "circuit-json-to-gerber": "^0.0.96",
    "circuit-json-to-kicad": "^0.0.174",
    "circuit-to-svg": "0.0.410",
    "jscad-electronics": "0.0.159",
    "jscad-to-gltf": "0.0.8",
    "jszip": "^3.10.1",
    "patch-package": "8.0.1",
    "transformation-matrix": "2.16.1",
    "tscircuit": "0.0.2462",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "circuit-json-to-altium": {
      "altiumts": "$altiumts"
    },
    "@tscircuit/core": "$@tscircuit/core",
    "@tscircuit/props": "$@tscircuit/props",
    "circuit-json": "$circuit-json"
  },
  "dependencies": {
    "@tsci/tscircuit.ti": "^1.0.102"
  }
}
